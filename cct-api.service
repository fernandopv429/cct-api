[Unit]
Description=API de Consulta de CCTs (pgvector)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cct-api
EnvironmentFile=/opt/cct-api/.env
ExecStart=/opt/cct-api/venv/bin/uvicorn api.cct_api:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
