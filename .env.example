# Banco de vetor (pgvector)
VECTOR_DATABASE_URL=postgres://postgres:SENHA@HOST:5435/postgres

# --- Provedor de embeddings ---
# "voyage" (recomendado) ou "openai"
EMBEDDING_PROVIDER=openai

# Voyage AI (https://dashboard.voyageai.com) — 200M tokens grátis na série 4
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=text-embedding-3-small

# Alternativa: OpenAI (EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small)
# OPENAI_API_KEY=sk-...

# Chave da SUA API — a mesma vai nos secrets do Base44.
# Gerar: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CCT_API_KEY=troque-por-uma-chave-forte

# Origens permitidas no CORS ("*" se o Base44 chamar por backend function)
CCT_ALLOWED_ORIGINS=*
