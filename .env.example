# Banco de vetor (pgvector). No próprio servidor pode usar localhost:5435.
VECTOR_DATABASE_URL=postgres://postgres:SENHA@127.0.0.1:5435/postgres

# Chave da OpenAI (embeddings da pergunta na consulta)
OPENAI_API_KEY=sk-...

# Chave da SUA API — invente uma forte. A mesma vai nos secrets do Base44.
# Gerar: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CCT_API_KEY=troque-por-uma-chave-forte

# Origens permitidas no CORS. Se o DocFlow chamar via BACKEND FUNCTION do Base44,
# CORS não se aplica e pode deixar "*". Se chamar do FRONTEND, coloque a origem do app.
CCT_ALLOWED_ORIGINS=*

# Modelo de embedding (deve casar com a dimensão da coluna: 1536 = text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small
